# Anthropic
ANTHROPIC_API_KEY=

# LangSmith (server-only observability)
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=elpac-tool
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Database
DATABASE_URL=postgresql://app_user:password@host:5432/elpac_tool
DATABASE_URL_MIGRATIONS=postgresql://migrations_user:password@host:5432/elpac_tool
DATABASE_SSL=true

# Clerk
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Encryption
# 32-byte hex string — generate with: openssl rand -hex 32
FIELD_ENCRYPTION_KEY=

# Environment
NODE_ENV=development
